{
  "name": "ello-webapp",
  "version": "3.0.21",
  "private": true,
  "scripts": {
    "clean": "rm -f .yarnclean public/static/*.css public/static/*.html public/static/*.js public/static/*.map",
    "build": "yarn run clean && NODE_ENV=production node ./node_modules/webpack/bin/webpack.js -p --progress --config=webpack.prod.config.js --env.commitsha=`git rev-parse HEAD`",
    "dev": "NODE_ENV=development babel-node src/server/dev.js",
    "start": "yarn dev",
    "mock": "node mock/server.js",
    "lint": "yarn lint:js && yarn lint:css",
    "lint:css": "stylelint 'src/**/*.css'",
    "lint:js": "eslint src test",
    "lint:js:fix": "eslint src test --fix",
    "pretest": "yarn lint",
    "test": "yarn test:all",
    "test:all": "NODE_ENV=test mocha",
    "test:watch": "NODE_ENV=test mocha --watch"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "eslintConfig": {
    "extends": "ello",
    "globals": {
      "AndroidInterface": false
    }
  },
  "stylelint": {
    "extends": "stylelint-config-primer",
    "rules": {
      "comment-empty-line-before": null,
      "selector-class-pattern": null,
      "selector-no-type": null,
      "no-unsupported-browser-features": [
        true,
        {
          "browsers": "> 5%, last 2 firefox versions, last 2 chrome versions, last 2 safari versions, last 2 edge versions, ie 11, not OperaMini all",
          "ignore": [
            "calc",
            "flexbox",
            "viewport-units",
            "will-change"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "classnames": "2.2.5",
    "exif-js": "2.3.0",
    "glamor": "3.0.0-1",
    "honeybadger-js": "0.5.4",
    "humps": "2.0.1",
    "immutable": "3.8.2",
    "isomorphic-fetch": "2.2.1",
    "jwt-decode": "2.2.0",
    "lodash": "4.17.10",
    "moment": "2.22.2",
    "mousetrap": "1.6.2",
    "postcss": "6.0.22",
    "postcss-apply": "0.8.0",
    "postcss-calc": "6.0.1",
    "postcss-color-function": "4.0.1",
    "postcss-custom-media": "6.0.0",
    "postcss-custom-properties": "6.1.0",
    "postcss-import": "10.0.0",
    "postcss-loader": "2.1.5",
    "postcss-pxtorem": "4.0.1",
    "postcss-reporter": "4.0.0",
    "postcss-url": "7.3.2",
    "prop-types": "15.6.1",
    "react": "15.6.1",
    "react-dom": "15.6.1",
    "react-fastclick": "3.0.2",
    "react-helmet": "5.2.0",
    "react-redux": "5.0.7",
    "react-router": "3.0.2",
    "react-router-redux": "4.0.8",
    "react-router-scroll": "0.4.4",
    "react-slick": "0.14.11",
    "react-slide": "0.3.0",
    "redux": "3.7.2",
    "redux-logger": "3.0.6",
    "redux-persist": "4.8.3",
    "redux-persist-immutable": "4.3.1",
    "redux-persist-transform-immutable": "4.3.0",
    "redux-saga": "0.15.6",
    "reselect": "3.0.1",
    "transit-immutable-js": "0.7.0",
    "trunc-html": "1.1.2",
    "tween.js": "16.6.0",
    "url-regex": "3.2.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.1.0",
    "@babel/core": "^8.1.2",
    "@babel/node": "^8.1.2",
    "@babel/plugin-transform-react-constant-elements": "^8.0.5",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-flow": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@babel/register": "^8.1.2",
    "autoprefixer": "7.1.2",
    "babel-eslint": "7.2.3",
    "babel-loader": "^10.1.1",
    "babel-plugin-lodash": "^3.3.4",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "chai": "3.5.0",
    "chai-generator": "2.1.0",
    "chai-immutable": "1.6.0",
    "core-js": "^3.51.0",
    "css-loader": "0.28.11",
    "dotenv": "4.0.0",
    "eslint": "3.19.0",
    "eslint-config-ello": "1.0.5",
    "express": "4.16.3",
    "extract-text-webpack-plugin": "3.0.2",
    "html-loader": "0.5.5",
    "html-webpack-plugin": "2.30.1",
    "http-proxy": "1.17.0",
    "jsdom": "11.11.0",
    "mocha": "^11",
    "react-addons-perf": "15.4.2",
    "react-addons-test-utils": "15.6.2",
    "regenerator-runtime": "^0.14.1",
    "sinon": "2.4.1",
    "sinon-chai": "2.12.0",
    "source-map-support": "0.4.15",
    "style-loader": "0.18.2",
    "stylelint": "7.12.0",
    "stylelint-config-primer": "1.4.0",
    "webpack": "3.4.1",
    "webpack-dev-middleware": "1.12.0",
    "webpack-hot-middleware": "2.22.2",
    "webpack-s3-plugin": "1.0.0-rc.0"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead",
    "not ie 11",
    "not op_mini all"
  ]
}
